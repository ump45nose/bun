+#[test]
+fn the_line_map_is_the_one_of_tsc() {
+    assert_eq!(
+        compute_ecma_line_starts("a\nb\r\nc\rd\u{2028}e\u{2029}f\n".as_bytes()),
+        [0, 2, 5, 7, 11, 15, 17]
+    );
+    assert_eq!(compute_ecma_line_starts(b""), [0]);
+    assert_eq!(compute_ecma_line_starts(b"\xE2\x80"), [0]);
+    assert_eq!(utf16_len(b"abc"), 3);
+    assert_eq!(utf16_len("\u{E9}\u{4E2D}".as_bytes()), 2);
+    assert_eq!(utf16_len("\u{1F600}".as_bytes()), 2);
+    assert_eq!(utf16_len(b"\xFF"), 1);
+    assert_eq!(utf16_len(b"\xE2\x82"), 2);
+    assert_eq!(utf16_len(b"\xED\xA0\x80"), 3);
+    assert_eq!(utf16_len(b"\xC0\x80"), 2);
+    assert_eq!(utf16_len(b"\xF0\x9F\x98"), 3);
+    assert_eq!(utf16_len(b"\xF4\x90\x80\x80"), 4);
+
+    let position = |text: &str, pos: u32| -> (usize, u32) {
+        let mut files = Files::default();
+        let id = file(&mut files, "/p.ts", "p.ts", text);
+        get_ecma_line_and_utf16_character_of_position(files.get(id).expect("file"), pos)
+    };
+    assert_eq!(position("ab\ncd\n", 6), (2, 0));
+    assert_eq!(position("ab\ncd\n", 99), (2, 0));
+    assert_eq!(position("ab\ncd", 5), (1, 2));
+    assert_eq!(position("ab\rcd", 3), (1, 0));
+    assert_eq!(position("ab\rcd", 4), (1, 1));
+    assert_eq!(position("ab\r\ncd", 3), (0, 3));
+    assert_eq!(position("ab\r\ncd", 4), (1, 0));
+    assert_eq!(position("ab\u{2028}cd", 5), (1, 0));
+    assert_eq!(position("a\u{1F600}b", 5), (0, 3));
+    assert_eq!(position("", 0), (0, 0));
+}

+    let mut diagnostics = Vec::new();
+
+    let mut log = Log::init();
+    let source = files.get(c).expect("c").source();
+    log.add_range_error(
+        Some(source),
+        Range {
+            loc: Loc { start: 8 },
+            len: 1,
+        },
+        b"Unexpected ;",
+    );
+    log.add_range_warning(
+        Some(source),
+        Range {
+            loc: Loc { start: 0 },
+            len: 3,
+        },
+        b"A warning of the parser",
+    );
+    log.add_range_debug(Some(source), Range::NONE, b"left out");
+    diagnostics_from_msgs(c, core::mem::take(&mut log.msgs), &mut diagnostics);
+
+    let mut log = Log::init();
+    log.add_range_error_with_code(
+        Some(files.get(d).expect("d").source()),
+        Range {
+            loc: Loc { start: 25 },
+            len: 1,
+        },
+        1110,
+        Cow::Borrowed(b"Type expected."),
+        Box::default(),
+    );
+    diagnostics_from_msgs(d, core::mem::take(&mut log.msgs), &mut diagnostics);
+
+    let mut log = Log::init();
+    log.add_symbol_already_declared_error(
+        files.get(e).expect("e").source(),
+        b"a",
+        Loc { start: 11 },

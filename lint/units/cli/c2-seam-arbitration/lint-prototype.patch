+#[test]
+fn names() {
+    let names = |cwd: &str, operand: &str| -> (BString, BString) {
+        let (name, display) = names_of(cwd.as_bytes(), operand.as_bytes());
+        (
+            BString::from(name.into_vec()),
+            BString::from(display.into_vec()),
+        )
+    };
+    let pair = |name: &str, display: &str| (BString::from(name), BString::from(display));
+    assert_eq!(names("/proj", "a.ts"), pair("/proj/a.ts", "a.ts"));
+    assert_eq!(
+        names("/proj", "./src/../src/a.ts"),
+        pair("/proj/src/a.ts", "src/a.ts")
+    );
+    assert_eq!(
+        names("/proj", "/proj/src/a.ts"),
+        pair("/proj/src/a.ts", "src/a.ts")
+    );
+    assert_eq!(
+        names("/proj", "/other/b.ts"),
+        pair("/other/b.ts", "../other/b.ts")
+    );
+    assert_eq!(names("/proj", "../b.ts"), pair("/b.ts", "../b.ts"));
+    assert_eq!(names("/proj/", "a.ts"), pair("/proj/a.ts", "a.ts"));
+    assert_eq!(names("/", "a.ts"), pair("/a.ts", "a.ts"));
+}

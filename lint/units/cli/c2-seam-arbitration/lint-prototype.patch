+    diagnostics_from_msgs(e, core::mem::take(&mut log.msgs), &mut diagnostics);
+
+    assert_eq!(diagnostics.len(), 4);
+    assert_eq!(diagnostics[2].code, Code::Ts(1110));
+    assert_eq!(diagnostics[3].related.len(), 1);
+    assert_eq!(diagnostics[3].related[0].category, Category::Message);
+    assert_eq!(
+        (
+            diagnostics[3].related[0].start,
+            diagnostics[3].related[0].length
+        ),
+        (4, 1)
+    );
+    assert_eq!(
+        plain(&files, &diagnostics),
+        "c.js(1,9): error syntax: Unexpected ;\n\
+         c.js(1,1): warning syntax: A warning of the parser\n\
+         d.ts(1,24): error TS1110: Type expected.\n\
+         e.js(2,5): error syntax: \"a\" has already been declared\n"
+    );
+    assert_eq!(
+        frames(&files, &diagnostics),
+        "1 | let x = ;\n            ^\nerror: syntax: Unexpected ;\n    at c.js:1:9\n\n\
+         1 | let x = ;\n    ^\nwarn: syntax: A warning of the parser\n   at c.js:1:1\n\n\

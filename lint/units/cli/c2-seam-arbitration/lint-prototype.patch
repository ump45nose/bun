+fn file(files: &mut Files, name: &str, display: &str, text: &str) -> FileId {
+    files
+        .add(
+            name.as_bytes().into(),
+            display.as_bytes().into(),
+            text.as_bytes().to_vec(),
+        )
+        .expect("file")
+}
+
+fn diag(
+    file: Option<FileId>,
+    start: u32,
+    length: u32,
+    code: Code,
+    text: &'static str,
+) -> Diagnostic {
+    Diagnostic {
+        file,
+        start,
+        length,
+        category: Category::Error,
+        code,
+        text: Cow::Borrowed(text.as_bytes()),
+        chain: Vec::new(),
+        related: Vec::new(),
+    }
+}
